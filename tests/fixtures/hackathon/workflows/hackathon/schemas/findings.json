{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor",
              "nit"
            ],
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "severity",
          "summary"
        ],
        "title": "Finding",
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "Adversary findings",
  "type": "object"
}
