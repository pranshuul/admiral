{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario/1",
  "title": "Scripted-agent harness scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "name", "steps"],
  "properties": {
    "format": { "const": "scenario/1" },
    "name": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expect_next"],
        "properties": {
          "child": { "type": "string", "description": "Item id passed as --child to next and advance" },
          "expect_next": { "description": "The exact JSON the runtime's next --json must print" },
          "advance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node", "result", "expect"],
            "properties": {
              "node": { "type": "string" },
              "result": { "description": "Written to a file and passed as --result" },
              "usage": { "description": "Passed as --usage, as JSON" },
              "ack": { "description": "Passed as --ack, as JSON" },
              "expect": { "description": "The exact JSON the runtime's advance --json must print" }
            }
          }
        }
      }
    }
  }
}
